# Copy this file to backend/.env.
# It is used when you run the API, the tests or the evaluation outside Docker.
# Inside Docker Compose, docker-compose.yml sets these values for the containers.

DATABASE_URL=postgresql+psycopg2://docuaudit:docuaudit@localhost:5432/docuaudit
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
UPLOAD_DIR=./data/uploads

# Signs login tokens. Use a long random value, and never commit the real one.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
DOCUAUDIT_SECRET=

# Language-model check in the auditor: veto (default), strict or off
# DOCUAUDIT_NLI_MODE=veto
